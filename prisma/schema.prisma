generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id         String   @id @default(uuid())
  userId     String
  productId  String
  totalCents Int
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Product{
  id              String   @id @default(uuid())
  name            String
  description     String?
  price           Int
  category        String
  imageUrl        String
  inStock         Boolean
  inventoryCount  Int
  rating          Int @default(0)
  reviewCount     Int @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([inventoryCount])
}