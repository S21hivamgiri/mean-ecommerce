{
  "name": "@myCommerce/shop",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:shop"
    ],
    "targets": {
      "serve": {
        "dependsOn": [
          "@myCommerce/api:serve",
          "@myCommerce/inventory:serve",
          "@myCommerce/outbox:serve",
          "@myCommerce/payment:serve"
        ]
      },
      "dev": {
        "dependsOn": [
          "@myCommerce/api:serve",
          "@myCommerce/outbox:serve",
          "@myCommerce/inventory:serve",
          "@myCommerce/payment:serve"
        ]
      },
      "preview": {
        "dependsOn": [
          "build",
          "@myCommerce/api:serve",
          "@myCommerce/payment:serve",
          "@myCommerce/outbox:serve",
          "@myCommerce/inventory:serve"
        ]
      }
    }
  },
  "devDependencies": {
    "@myCommerce/models": "*",
    "@myCommerce/shop-data": "*",
    "@myCommerce/shop-feature-product-detail": "*",
    "@myCommerce/shop-feature-products": "*",
    "@myCommerce/shop-shared-ui": "*"
  }
